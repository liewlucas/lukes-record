---
import Base from '../../../layouts/Base.astro';
import Journey from '../../../components/Journey.astro';
import SceneMount from '../../../components/SceneMount.astro';
import { getSettings } from '../../../lib/storyblok';

const settings = await getSettings();
---

<Base title={`Bookshelf, ${settings.ownerName}`} description="Reading, with a note tucked inside each book." zone="vista" navCurrent="cabin" footerText={settings.footerText} navInPage>
  <SceneMount slot="scene" zone="books" />
  <Journey start="books" />
</Base>
