---
import Base from '../../../layouts/Base.astro';
import Journey from '../../../components/Journey.astro';
import SceneMount from '../../../components/SceneMount.astro';
import { getSettings } from '../../../lib/storyblok';

const settings = await getSettings();
---

<Base title={`Prints, ${settings.ownerName}`} description="Photographs, pegged on a line." zone="vista" navCurrent="cabin" footerText={settings.footerText} navInPage>
  <SceneMount slot="scene" zone="photos" />
  <Journey start="photos" />
</Base>
