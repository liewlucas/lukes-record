---
/** Spines on a shelf. Open one and the bookmark note slides out. No JavaScript needed. */
import type { Book } from '../lib/types';
import RichText from './RichText.astro';

interface Props {
  books: Book[];
}
const { books } = Astro.props;
const statusLabel: Record<Book['status'], string> = {
  reading: 'reading now',
  finished: 'finished',
  favorite: 'a favourite',
};
const inkFor = (c: string) => (['kraft', 'lamp-amber', 'ridge-haze'].includes(c) ? 'var(--walnut)' : 'var(--parchment)');
---

<div class="bookshelf">
  {books.map((b) => (
    <details class="book" id={b.slug} style={`--spine:var(--${b.spineColor});--ink:${inkFor(b.spineColor)}`}>
      <summary>
        <span class="spine">
          <span class="title">{b.title}</span>
          {b.author && <span class="author">{b.author}</span>}
        </span>
      </summary>
      <div class="bookmark">
        <p class="bookmark-title">{b.title}{b.author && <span class="mono"> {b.author}</span>}</p>
        <p class="mono status">{statusLabel[b.status]}</p>
        <RichText document={b.note} serif />
      </div>
    </details>
  ))}
  <div class="plank" aria-hidden="true"></div>
</div>

<style>
  .bookshelf {
    position: relative;
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    gap: 4px 3px;
    padding: 0 1rem;
    transition: margin-bottom 0.5s var(--ease-settle);
  }
  .bookshelf:has(.book[open]) {
    margin-bottom: 17rem;
  }
  .book {
    position: static;
  }
  summary {
    list-style: none;
    cursor: pointer;
  }
  summary::-webkit-details-marker {
    display: none;
  }
  .spine {
    display: grid;
    grid-template-rows: 1fr auto;
    align-items: center;
    justify-items: center;
    width: 2.6rem;
    height: 13rem;
    padding: 0.7rem 0;
    background: var(--spine);
    color: var(--ink);
    box-shadow:
      inset 3px 0 0 rgb(255 255 255 / 0.14),
      inset -2px 0 0 rgb(0 0 0 / 0.25);
    transition: transform 0.5s var(--ease-settle), box-shadow 0.5s var(--ease-settle);
  }
  .title,
  .author {
    writing-mode: vertical-rl;
    transform: rotate(180deg);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .title {
    font-family: var(--font-display);
    font-variation-settings: 'opsz' 14, 'SOFT' 50;
    font-size: 0.98rem;
    max-height: 9rem;
  }
  .author {
    font-family: var(--font-mono);
    font-size: 0.62rem;
    opacity: 0.8;
    max-height: 3rem;
  }
  summary:hover .spine,
  summary:focus-visible .spine,
  .book[open] .spine {
    transform: translateY(-0.8rem);
    box-shadow:
      inset 3px 0 0 rgb(255 255 255 / 0.14),
      inset -2px 0 0 rgb(0 0 0 / 0.25),
      0 0 0 1px rgb(217 164 65 / 0.6),
      0 12px 28px -10px rgb(217 164 65 / 0.5);
  }
  summary:focus-visible {
    outline: none;
  }
  .bookmark {
    position: absolute;
    left: 1rem;
    top: calc(100% + 1.4rem);
    z-index: 3;
    width: min(26rem, calc(100% - 2rem));
    max-height: 15rem;
    overflow: auto;
    padding: 1rem 1.2rem 1.1rem;
    background:
      var(--grain-soft),
      linear-gradient(180deg, #ecdfc7, var(--kraft));
    background-blend-mode: multiply, normal;
    color: var(--walnut);
    box-shadow: 0 20px 40px -20px rgb(0 0 0 / 0.8);
    animation: settle 0.6s var(--ease-settle) both;
  }
  .bookmark::before {
    content: '';
    position: absolute;
    top: -0.5rem;
    left: 1.2rem;
    width: 1rem;
    height: 1rem;
    background: inherit;
    transform: rotate(45deg);
  }
  .bookmark-title {
    font-family: var(--font-display);
    font-size: var(--step-1);
    margin: 0 0 0.2rem;
  }
  .status {
    margin: 0 0 0.5rem;
    font-size: 0.75rem;
    color: var(--burnt-sienna);
  }
  .bookmark :global(.prose) {
    font-size: 0.95em;
  }
  .bookmark :global(.prose p:last-child) {
    margin-bottom: 0;
  }
  .plank {
    flex-basis: 100%;
    height: 12px;
    margin: 0 -1rem;
    background: linear-gradient(180deg, #5b4531, #3a2a1d);
    box-shadow: 0 10px 20px -8px rgb(0 0 0 / 0.6);
  }
  @media (prefers-reduced-motion: reduce) {
    .bookmark {
      animation: none;
    }
  }
</style>
