---
/** A single print, large, with its film metadata set in mono. */
import type { Photo } from '../lib/types';

interface Props {
  photo: Photo;
  prev?: Photo;
  next?: Photo;
}
const { photo, prev, next } = Astro.props;
const meta: Array<[string, string | undefined]> = [
  ['Camera', photo.camera],
  ['Film', photo.filmStock],
  ['Location', photo.location],
  ['Year', photo.year],
];
---

<figure class="lightbox">
  <div class="frame">
    {photo.src ? <img src={photo.src} alt={photo.alt} /> : <div class="blank" aria-hidden="true"></div>}
  </div>
  <figcaption>
    {photo.caption && <p class="caption">{photo.caption}</p>}
    <dl class="meta mono">
      {meta.filter(([, v]) => v).map(([k, v]) => (
        <div><dt>{k}</dt><dd>{v}</dd></div>
      ))}
    </dl>
    <nav class="mono neighbours" aria-label="Other prints">
      {prev ? <a href={`/cabin/photos/${prev.slug}`}>previous print</a> : <span></span>}
      <a href="/cabin/photos">all prints</a>
      {next ? <a href={`/cabin/photos/${next.slug}`}>next print</a> : <span></span>}
    </nav>
  </figcaption>
</figure>

<style>
  .lightbox {
    margin: 0;
    display: grid;
    gap: 1.5rem;
  }
  .frame {
    background: #fbf8f1;
    padding: clamp(0.6rem, 2vw, 1.25rem);
    box-shadow: 0 30px 60px -30px rgb(0 0 0 / 0.9);
    justify-self: center;
    max-width: 100%;
  }
  img,
  .blank {
    display: block;
    max-width: 100%;
    max-height: 72dvh;
    width: auto;
    height: auto;
    filter: contrast(0.94) saturate(0.88) sepia(0.14) brightness(1.03);
  }
  .blank {
    width: min(80vw, 48rem);
    aspect-ratio: 3 / 2;
    background: linear-gradient(160deg, #c8b79b, #8fa3b0);
  }
  .caption {
    font-family: var(--font-display);
    font-style: italic;
    font-size: var(--step-1);
    margin: 0 0 0.75rem;
  }
  .meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 2rem;
    margin: 0 0 1.25rem;
    font-size: 0.8rem;
  }
  .meta div {
    display: flex;
    gap: 0.6rem;
  }
  dt {
    opacity: 0.6;
  }
  dd {
    margin: 0;
  }
  .neighbours {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    font-size: 0.8rem;
  }
</style>
