---
import type { Plaque } from '../lib/types';

interface Props {
  items: Plaque[];
  label?: string;
}
const { items, label = 'Elsewhere' } = Astro.props;
---

{items.length > 0 && (
  <nav class="plaques" aria-label={label}>
    <ul>
      {items.map((p) => (
        <li><a class="plaque" href={p.href} rel="me noopener">{p.label}</a></li>
      ))}
    </ul>
  </nav>
)}

<style>
  ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }
</style>
