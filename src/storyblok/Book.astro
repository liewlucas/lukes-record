---
import { storyblokEditable } from '@storyblok/astro';
import Bookshelf from '../components/Bookshelf.astro';
import { book } from '../lib/content';

interface Props {
  blok: Record<string, unknown> & { _uid: string; component: string };
  slug?: string;
  name?: string;
}
const { blok, slug = 'preview', name = 'Preview' } = Astro.props;
const model = book({ slug, full_slug: slug, name, content: blok });
---

<div {...storyblokEditable(blok as never)} class="wrap" style="padding-block: 3rem 12rem">
  <Bookshelf books={[model]} />
</div>
