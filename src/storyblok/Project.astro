---
/** Visual Editor renderer for `project` (and the space's existing `projects`) stories. */
import { storyblokEditable } from '@storyblok/astro';
import LinerNotes from '../components/LinerNotes.astro';
import { project } from '../lib/content';

interface Props {
  blok: Record<string, unknown> & { _uid: string; component: string };
  slug?: string;
  name?: string;
}
const { blok, slug = 'preview', name = 'Preview' } = Astro.props;
const model = project({ slug, full_slug: slug, name, content: blok });
---

<div {...storyblokEditable(blok as never)} class="wrap" style="padding-block: 3rem">
  <LinerNotes project={model} />
</div>
