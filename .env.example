# Copy to `.env` (gitignored). Never commit real values.

# Storyblok PREVIEW token: Space → Settings → Access Tokens. Reads draft and published content,
# which the /preview route needs. Leave empty to build with placeholder content.
STORYBLOK_PREVIEW_TOKEN=

# Content version for build-time fetches: draft | published.
# Default is draft for `npm run dev` and published for `npm run build`.
STORYBLOK_VERSION=

# Region of the Storyblok space: eu | us | ca | ap | cn
STORYBLOK_REGION=eu

# Public URL of the deployed site (canonical links).
PUBLIC_SITE_URL=https://the-cabin-at-golden-hour.workers.dev

# Management API (scripts/storyblok-sync-schema.mjs only). Personal access token: My account → Security.
STORYBLOK_MANAGEMENT_TOKEN=
STORYBLOK_SPACE_ID=
